{
  "name": "UPI Ecosystem Analytics",
  "dataColors": ["#1F4E79", "#E07A1F", "#6C8EBF", "#2E8B57", "#A23B72", "#8C8C8C", "#C9A227", "#4BA3C3"],
  "background": "#FFFFFF",
  "foreground": "#1A1A1A",
  "tableAccent": "#1F4E79",
  "good": "#2E8B57",
  "neutral": "#C9A227",
  "bad": "#C0392B",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1A1A1A" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1A1A1A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#4A4A4A" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F4E79" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } } }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E7ED" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }] }
    }
  }
}
