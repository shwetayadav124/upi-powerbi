table fact_forecast
	lineageTag: b30da601-4dea-49d3-9d82-f0db8b39fc15

	column date_key
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 40955d6a-ab13-4366-b382-029846d944d6
		summarizeBy: none
		sourceColumn: date_key

	column type
		dataType: string
		lineageTag: fb4e97de-13e9-49e8-9c75-ef5f55859c6b
		summarizeBy: none
		sourceColumn: type

	column forecast_volume_mn
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: e41492fa-12f1-485c-b3ac-c047ea3aca19
		summarizeBy: sum
		sourceColumn: forecast_volume_mn

	column lower_80_mn
		dataType: double
		isHidden
		formatString: #,0.00
