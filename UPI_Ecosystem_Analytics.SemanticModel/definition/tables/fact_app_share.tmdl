	partition fact_app_share = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_app_share.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"app_id", Int64.Type}, {"volume_share_pct", type number}, {"value_share_pct", type number}, {"source", type text}}, "en-US")
				in
				    Typed

