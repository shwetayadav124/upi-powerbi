				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"banks_live", Int64.Type}, {"volume_mn", type number}, {"value_cr", type number}, {"days_in_month", Int64.Type}, {"avg_daily_volume_mn", type number}, {"avg_ticket_rs", type number}, {"source", type text}}, "en-US")
