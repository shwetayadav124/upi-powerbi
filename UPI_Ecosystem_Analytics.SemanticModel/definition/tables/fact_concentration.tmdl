				    Typed = Table.TransformColumnTypes(Promoted, {{"date_key", Int64.Type}, {"top2_share_pct", type number}, {"top3_share_pct", type number}, {"hhi_lower_bound", type number}, {"apps_above_30pct_cap", Int64.Type}}, "en-US")
