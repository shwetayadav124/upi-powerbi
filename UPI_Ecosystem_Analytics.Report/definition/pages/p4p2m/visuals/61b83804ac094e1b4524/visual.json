                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■  Merchants drive the count, people drive the money.  ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1F4E79"
                    }
                  },
                  {
                    "value": "P2M is ~63% of transactions but only ~29% of value.",
