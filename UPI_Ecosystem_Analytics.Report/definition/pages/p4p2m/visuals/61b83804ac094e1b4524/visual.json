                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "■  Ticket sizes tell the story.  ",
                    "textStyle": {
                      "fontSize": "15pt",
                      "fontWeight": "bold",
                      "color": "#1F4E79"
                    }
                  },
                  {
                    "value": "A person-to-person transfer averages ~₹2,500 vs ~₹600 for a merchant payment (about 4×), so UPI is now the default for small everyday spends.",
                    "textStyle": {
                      "fontSize": "14pt",
                      "color": "#1A1A1A"
                    }
                  }
                ]
              },
